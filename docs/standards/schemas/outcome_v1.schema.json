{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "outcome.v1",
  "title": "D1 Outcome v1（outcome_id 可追）",
  "description": "IFS F1 单接口 schema：interface_id=outcome.get（内部契约，T+1 sidecar）。要求 outcome_id 与上游 trade_id/decision_id/四 ID 贯通；行情缺失一律显式 null（不伪造，IFS-07）。只读回填，不自动训练、不写交易链。",
  "type": "object",
  "required": [
    "schema_version",
    "outcome_id",
    "decision_id",
    "trade_id",
    "date",
    "symbol",
    "recommendation",
    "next_trade_date",
    "next_close",
    "next_day_return",
    "hit",
    "pit_as_of",
    "paper_only"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "outcome/v1"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^out-\\d{8}-[0-9A-F]{8}$",
      "description": "ID chain 权威节点 outcome_id"
    },
    "decision_id": {
      "anyOf": [
        {"type": "string", "pattern": "^D1-\\d{8}-[0-9a-f]{10}$"},
        {"type": "string", "pattern": "^d1-\\d{14}-[0-9a-f]{6}$"}
      ]
    },
    "trade_id": {
      "type": ["string", "null"],
      "pattern": "^trd-\\d{8}-[0-9A-F]{8}$",
      "description": "无 paper 成交时显式 null（不伪造）"
    },
    "confirmation_id": {
      "type": ["string", "null"],
      "pattern": "^CFM-[0-9A-F]{12}$"
    },
    "handoff_id": {
      "type": ["string", "null"],
      "pattern": "^d1h-\\d{14}-[0-9a-f]{6}$"
    },
    "watch_plan_id": {
      "type": ["string", "null"],
      "pattern": "^wp-\\d{8}-[0-9a-f]{6}$"
    },
    "date": {
      "description": "决策/成交日（YYYYMMDD 或 YYYY-MM-DD）",
      "anyOf": [
        {"type": "string", "pattern": "^\\d{8}$"},
        {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      ]
    },
    "next_trade_date": {
      "type": ["string", "null"],
      "description": "下一交易日；缺失显式 null"
    },
    "symbol": {
      "type": "string",
      "pattern": "^(sh|sz|bj)?\\d{6}$"
    },
    "recommendation": {
      "type": "string",
      "enum": ["BUY", "SELL", "WATCH", "HOLD"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "next_close": {
      "type": ["number", "null"],
      "description": "T+1 收盘价；缺行情显式 null（不猜）"
    },
    "next_day_return": {
      "type": ["number", "null"],
      "description": "T+1 收益（百分数）；缺行情显式 null（不造数）"
    },
    "hit": {
      "type": ["boolean", "null"],
      "description": "方向是否命中；不可判定显式 null"
    },
    "horizon_days": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "pit_as_of": {
      "type": ["string", "null"],
      "description": "PIT 数据时点；与采集时间分离（as_of≠采集时间）"
    },
    "raw_refs_status": {
      "type": ["string", "null"],
      "enum": ["none", "partial", "full", "invalid", null]
    },
    "paper_only": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": "outcome/v1",
      "outcome_id": "out-20261104-A1B2C3D4",
      "decision_id": "D1-20261102-8f3a1c2b90",
      "trade_id": "trd-20261103-1A2B3C4D",
      "confirmation_id": "CFM-1A2B3C4D5E6F",
      "handoff_id": "d1h-20261102170000-a1b2c3",
      "watch_plan_id": "wp-20261102-a1b2c3",
      "date": "20261103",
      "next_trade_date": "20261104",
      "symbol": "sz003006",
      "recommendation": "BUY",
      "confidence": 0.62,
      "next_close": 22.75,
      "next_day_return": 2.94,
      "hit": true,
      "horizon_days": 1,
      "pit_as_of": "20261103",
      "raw_refs_status": "full",
      "paper_only": true
    }
  ]
}
