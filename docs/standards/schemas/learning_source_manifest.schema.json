{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "learning_source_manifest.v1",
 "title": "Learning Source Manifest v1",
 "type": "object",
 "required": [
  "schema_version",
  "project_id",
  "generated_at",
  "files"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "const": "learning_source_manifest.v1"
  },
  "project_id": {
   "type": "string"
  },
  "generated_at": {
   "type": "string"
  },
  "files": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "sha256",
     "size",
     "origin",
     "copied"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "sha256": {
      "type": "string",
      "minLength": 64
     },
     "size": {
      "type": "integer",
      "minimum": 0
     },
     "origin": {
      "type": "string"
     },
     "copied": {
      "type": "boolean"
     },
     "text_md": {
      "type": "string"
     },
     "ingested_at": {
      "type": "string"
     }
    }
   }
  }
 }
}