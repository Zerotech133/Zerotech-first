{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "learning_unit.v1",
 "title": "Learning Unit v1",
 "type": "object",
 "required": [
  "schema_version",
  "unit_id",
  "project_id",
  "claim",
  "evidence",
  "status",
  "created_at"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "const": "learning_unit.v1"
  },
  "unit_id": {
   "type": "string"
  },
  "project_id": {
   "type": "string"
  },
  "claim": {
   "type": "string",
   "minLength": 8
  },
  "evidence": {
   "type": "object",
   "required": [
    "file",
    "line"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "line": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "status": {
   "type": "string",
   "enum": [
    "draft",
    "approved",
    "rejected"
   ]
  },
  "created_at": {
   "type": "string"
  }
 }
}