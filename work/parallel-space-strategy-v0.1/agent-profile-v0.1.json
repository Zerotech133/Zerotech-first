    "sandbox_requires_offline_signature": false,
    "sandbox_requires_permission_snapshot": false,
    "sandbox_requires_time_split_receipt": false,
    "production_eligible": false,
    "financial_execution_enabled": false,
    "simulated_execution_enabled": false,
    "commercialization_enabled": false,
    "evidence_policy": "optional_internal_provenance_only"
  },
  "training": {
    "method": "distillation_then_optional_lora",
    "base_model": "qwen3.5:4b",
