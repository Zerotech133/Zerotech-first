{
  "schema": "parallel_space_strategy_dataset/v1",
  "purpose": "策略智能体监督学习、蒸馏和离线评测的样本协议",
  "record_required_fields": [
    "sample_id",
    "task_type",
    "scenario_packet",
    "teacher_decision",
    "teacher_reasoning",
    "risk_level",
    "abstain",
    "invalidating_conditions"
  ],
  "scenario_packet_fields": [
    "market_domain",
    "as_of",
    "timeframe",
    "price_features",
    "technical_features",
    "fundamental_features",
    "event_features",
    "chart_description",
    "missing_fields"
  ],
  "task_types": [
    "regime_classification",
    "strategy_selection",
    "candidate_ranking",
    "risk_review",
    "missing_data_abstention",
    "teacher_student_critique"
  ],
  "optional_fields": [
    "provenance_note",
    "teacher_agent_id",
    "student_agent_id",
    "agent_dialogue",
    "quality_label",
    "scenario_group"
  ],
  "rules": [
    "场景缺少关键字段时teacher_decision必须允许abstain=true",
    "teacher_reasoning只能引用scenario_packet或明确标记为假设",
    "策略选择不等于交易指令，样本不得包含订单动作接口",
    "synthetic样本必须标记provenance_note为synthetic_fixture"
  ]
}
