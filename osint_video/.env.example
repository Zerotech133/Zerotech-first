# ============================================================
# osint_video 环境变量样例 —— 复制为 .env 并按需修改
# 加载方式：config/settings.py（pydantic-settings，大小写不敏感）
# 注意：.env 与 config/secrets/ 必须加入 .gitignore，明文密钥不入库
# ============================================================

# ---------- PostgreSQL（必填；老田现有 Docker 容器） ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DB=osint

# ---------- Qdrant（本地可选派生索引；PG 始终为事实源） ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=osint_knowledge_units_v1
QDRANT_VECTOR_SIZE=384

# ---------- 飞书机器人 webhook（可选） ----------
# 未配置时 FeishuNotifier 自动降级为日志输出，不报错、不阻塞管线（架构 §7.7）
FEISHU_WEBHOOK_URL=

# ---------- 采集限速（合规护栏，硬下限校验） ----------
# 两次采集最小间隔秒数：默认 120（1 视频/2 分钟）
# ⚠️ 硬下限 30s：配置 <30 会在启动时直接报错，禁止机器速采集
COLLECT_INTERVAL_SEC=120
# 夜间静默窗口（本地小时，含首不含尾）：23:00–07:00 不采集
COLLECT_NIGHT_START_HOUR=23
COLLECT_NIGHT_END_HOUR=7

# ---------- 安全 ----------
# Cookie/Token Fernet 加密密钥（POST /api/v1/credentials/yuanbao_cookie 必需）
# 生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------- 日志 ----------
# 级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
