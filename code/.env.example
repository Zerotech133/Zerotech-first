# zhice-OS V2 环境变量示例

# 应用
APP_ENV=local-dev
APP_NAME=zhice-os-v2
APP_TIMEZONE=Asia/Shanghai

# 多用户执行模式（legacy=现有单用户行为不变；shadow=影子记账；enforced=按用户归属强制执行）
# Phase A 仅建立开关，暂无消费方，保持 legacy。
MULTI_USER_EXECUTION_MODE=legacy

# API 安全
INTERNAL_API_KEY=
# JWT 签名密钥（生产必须为非默认强随机值，否则启动校验失败）
SECRET_KEY=
# 初始 admin 口令（生产必须为强口令，禁 123456/admin/password）
ADMIN_PASSWORD=

# 持久化后端：sql（默认，生产强制）| memory（仅本地临时试跑，重启丢数据）
PERSISTENCE_BACKEND=sql

# 数据库（sql 后端使用）
DB_MAIN_URL=postgresql://zhice:zhice_pass@localhost:5432/zhice_os_v2

# Redis
REDIS_URL=redis://localhost:6379/0

# 研究网关
RESEARCH_GATEWAY_ENDPOINT=

# 交易授权
TRADE_APPROVAL_EXPIRE_SECONDS=300

# V1→V2 数据同步凭据（旧路径，现已改直连；保留兼容）
V1_DB_HOST=localhost
V1_DB_USER=zhice
V1_DB_PASSWORD=CHANGE_ME
V2_DB_HOST=localhost
V2_DB_NAME=zhice_os_v2
V2_DB_USER=zhice
V2_DB_PASSWORD=CHANGE_ME

# ---- 行情数据源直连（真实值写入 .env.local，勿提交）----
# CN 主源 DataCenter Open API（需 key）
DATACENTER_BASE_URL=http://datacenter.xundaotech.cn:24123
DATACENTER_API_KEY=CHANGE_ME
DATACENTER_TIMEOUT_MS=10000
DATACENTER_RETRY_MAX=3
# CN 结算/指数（需 key）
TUSHARE_TOKEN=CHANGE_ME
# US 快照中间层（需 key，空则跳过 Finnhub 用 yfinance）
FINNHUB_TOKEN=CHANGE_ME
# HK 长桥（三者齐全才启用，否则 yfinance 兜底）
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# ---- Telegram 推送与定向通知（真实值写入 .env.local，勿提交）----
# 推送 bot（@BotFather 创建；token 空则推送 best-effort 静默跳过）
TELEGRAM_BOT_TOKEN=CHANGE_ME
# 代理（国内直连 api.telegram.org 被墙）；如 http://127.0.0.1:7890，空则直连
TELEGRAM_PROXY=
# 通知模式：broadcast=现状全员广播（默认，保持不变）；shadow=只记录路由不发送；directed=按用户定向
# directed 必须搭配 MULTI_USER_EXECUTION_MODE=enforced，否则启动校验失败。
TELEGRAM_NOTIFICATION_MODE=broadcast
# 绑定开关：开启需 TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_USERNAME/TELEGRAM_WEBHOOK_SECRET 齐备，
# 且 TELEGRAM_WEBHOOK_PUBLIC_URL 为公网可信 https://（本机/159 HTTP、113 自签名均不满足，
# 保持 false 即关闭绑定，不影响其余功能）。
TELEGRAM_BINDING_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# ---- WxPusher 应用通知渠道（真实值写入 .env.local，勿提交）----
# 官方 APP_TOKEN（spt_ 开头）；空=渠道关闭。开启绑定还需 APP_ID/APP_KEY 齐备
WXPUSHER_APP_TOKEN=CHANGE_ME
WXPUSHER_APP_ID=0
WXPUSHER_APP_KEY=CHANGE_ME
# 回调路径鉴权 key：至少 32 个随机字符
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 绝不能提交真实值（泄漏=任意人可伪造绑定回调）
WXPUSHER_WEBHOOK_PATH_KEY=CHANGE_ME
# 绑定/投递开关默认全关（rollout 时逐项打开；开启绑定需 token/id/key/path_key 齐备）
WXPUSHER_BINDING_ENABLED=false
WXPUSHER_DELIVERY_ENABLED=false
WXPUSHER_CHALLENGE_TTL_SECONDS=600
WXPUSHER_TIMEOUT_SECONDS=8

# ---- 运维告警（企业微信群机器人 webhook；真实值写入 .env.local，勿提交）----
# Task 12 起该 webhook 只承载运维白名单告警（渠道鉴权失败/投递积压/worker 停滞/
# 终态失败率），普通用户业务正文（止损/风控拒绝/标的）不再进入
ALERT_WEBHOOK_URL=

# ---- BEpusdt 加密支付网关（P3，只收 USDT-TRC20；真实值写入 .env.local，勿提交）----
# 后端可达的 BEpusdt 基址；空=未接支付。本机宿主直跑用 http://127.0.0.1:8197
BEPUSDT_BASE_URL=
# BEpusdt 的 api_auth_token（生产启用支付时必填，≥8 位；空 token 会让回调可伪造）
BEPUSDT_API_TOKEN=
# BEpusdt 回调可达的后端基址（notify_url 前缀；生产须公网可信 https://）
BEPUSDT_NOTIFY_BASE_URL=
# 支付成功后用户跳转地址（可空）
BEPUSDT_REDIRECT_URL=
BEPUSDT_TRADE_TYPE=usdt.trc20
