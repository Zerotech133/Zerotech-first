# 客户门户 nginx 反代模板（示例，部署前按实际域名/证书路径修改）
# 放置：/etc/nginx/conf.d/analysis-customer.conf
#
# 安全约束：
# - 仅暴露客户相关路径；/api/analysis/* 与 /api/commercial/* 不对外
# - 证书路径按实际替换
# - 修改后：nginx -t && nginx -s reload（L2 变更，需批准）

server {
    listen 80;
    server_name analysis.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name analysis.example.com;

    ssl_certificate     /etc/letsencrypt/live/analysis.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/analysis.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 1m;

    # 客户入口
    location = / { return 302 /landing.html; }
    location = /landing.html { proxy_pass http://127.0.0.1:8734; proxy_set_header Host $host; }
    location = /cases.html   { proxy_pass http://127.0.0.1:8734; proxy_set_header Host $host; }
    location = /customer.html { proxy_pass http://127.0.0.1:8734; proxy_set_header Host $host; }
    location = /docs/customer/ { proxy_pass http://127.0.0.1:8734; proxy_set_header Host $host; }

    # 客户 API（登录/分析/报告/历史/配额/试用/埋点）
    location /api/customer/ {
        proxy_pass http://127.0.0.1:8734;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        limit_req zone=customer burst=20 nodelay;  # 需在 http{} 定义 limit_req_zone
    }

    # 静态资源
    location /static/ { proxy_pass http://127.0.0.1:8734; }

    # 其余一律拒绝（不暴露内部 API）
    location / { return 403; }
}
