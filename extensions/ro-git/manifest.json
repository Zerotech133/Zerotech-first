{
  "name": "ro-git",
  "version": "1.0.0",
  "type": "mcp",
  "owner": "ARCH1",
  "description": "MCP 只读 Git（status/log/diff，不写仓库）",
  "risk": "read-only",
  "transport": "stdio",
  "entry": "tools/mcp_ro_git.py",
  "allow_tools": [
    "git_status",
    "git_log",
    "git_diff"
  ],
  "docs": [
    "docs/ops/2026-10-27_工具操作手册_v1.md",
    "docs/testing.md"
  ],
  "tests": [
    "tools/test_mcp_security_check.py"
  ],
  "compat": {
    "min_platform": "2026.10",
    "python": ">=3.11"
  },
  "lifecycle": "active",
  "runtime": {
    "mcp_server": "git"
  }
}
