{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aios.local/schemas/extension-manifest-v1.json",
  "title": "aios extension manifest v1",
  "description": "扩展/工具的统一声明契约（只声明，不执行）。规则见 docs/specs/2026-10-27_扩展契约_v1.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "type",
    "owner",
    "description",
    "risk",
    "docs",
    "tests"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "enum": [
        "tool",
        "mcp",
        "skill",
        "filter"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "risk": {
      "enum": [
        "read-only",
        "write"
      ]
    },
    "l2_approved": {
      "type": "boolean"
    },
    "transport": {
      "enum": [
        "stdio",
        "http",
        "cli",
        "inprocess"
      ]
    },
    "entry": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "token_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,}$"
    },
    "allow_tools": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string",
          "enum": [
            "*"
          ]
        }
      ]
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "enum": [
        "active",
        "deprecated",
        "retired"
      ]
    },
    "notes": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "与运行配置的映射（契约镜像阶段：声明它对应哪个 servers.json 条目/tool entry）",
      "properties": {
        "mcp_server": {
          "type": "string"
        },
        "tool_entry": {
          "type": "string"
        }
      }
    }
  }
}
