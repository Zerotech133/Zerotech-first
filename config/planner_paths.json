{
 "schema": "planner_paths/v2",
 "note": "文档路由/关键词 → 精确文件；planner fallback 用它生成 write_scope，require_checks 再逐文件挂 file_exists",
 "routes": {
  "/keys": {
   "frontend": ["agent_platform/legion_command/static/keypool_v2.html"],
   "backend": ["agent_platform/legion_command/credential_catalog.py",
               "agent_platform/legion_command/serve.py",
               "agent_platform/legion_command/seat_router.py"]
  },
  "/mission": {
   "frontend": ["agent_platform/legion_command/static/mission.html"],
   "backend": ["agent_platform/legion_command/mission_planner.py",
               "agent_platform/legion_command/mission_dispatch.py"]
  },
  "/ide": {
   "frontend": ["portal/ide.html"],
   "backend": ["tools/build_agent_ide_bundle.py"]
  },
  "/legion": {
   "frontend": ["portal/legion.html"],
   "backend": ["portal/api_legion_ops_v2.py"]
  },
  "/council": {
   "frontend": ["portal/os_council.html"],
   "backend": ["portal/council_ops.py"]
  },
  "/picks": {
   "frontend": ["portal/picks.html"],
   "backend": ["portal/build_todays_picks.py"]
  },
  "/org": {
   "frontend": ["portal/org.html"],
   "backend": []
  },
  "/devops": {
   "frontend": ["portal/dev.html"],
   "backend": ["portal/api_dev_legion.py"]
  },
  "/os": {
   "frontend": ["portal/os.html"],
   "backend": []
  }
 },
 "keywords": {
  "凭据": {"backend": ["agent_platform/legion_command/credential_catalog.py"]},
  "key池": {"backend": ["agent_platform/legion_command/keypool.py"]},
  "虚拟key": {"backend": ["agent_platform/legion_command/seat_router.py"]},
  "mcp": {"backend": ["agent_platform/legion_command/mcp_bridge.py"]},
  "worker": {"backend": ["agent_platform/legion_command/mission_worker.py"]},
  "planner": {"backend": ["agent_platform/legion_command/mission_planner.py"]},
  "评审门": {"backend": ["tools/devtask.py"]},
  "模型路由": {"backend": ["config/seat_routing.json", "agent_platform/legion_command/seat_router.py"]},
  "语音": {"frontend": ["portal/ide.html"], "backend": ["tools/stt_sapi.ps1"]}
 }
}
