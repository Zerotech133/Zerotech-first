# 复制为 .env.prod 并填写真实值
# cp .env.prod.example .env.prod

# 生产模式（启用强密钥与管理员密码校验）
APP_ENV=prod

# 数据库
DB_USER=zhice
DB_PASSWORD=改成强密码_至少16位
DB_NAME=zhice_os_v2

# JWT 签名密钥（64位随机字符串）
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=改成随机64字符

# 管理员密码
ADMIN_PASSWORD=改成强密码

# 调度市场（空=CN/US/HK/CRYPTO 全部）
SCHEDULER_MARKETS=

# 多用户执行模式（legacy=现有单用户行为不变；shadow=影子记账；enforced=按用户归属强制执行）
# Phase A 仅建立开关，暂无消费方，保持 legacy。
MULTI_USER_EXECUTION_MODE=legacy

# CN 市场数据（DataCenter 当前仅提供 HTTP；生产建议经受控网络或 TLS 代理访问）
DATACENTER_BASE_URL=http://datacenter.xundaotech.cn:24123
DATACENTER_API_KEY=
DATACENTER_TIMEOUT_MS=10000
DATACENTER_RETRY_MAX=3
TUSHARE_TOKEN=

# 可选：V1 US 分钟源库。密码为空时明确禁用该同步任务，不影响其他市场任务。
V1_DB_HOST=localhost
V1_DB_USER=zhice
V1_DB_PASSWORD=

# Telegram 推送（按服务器实际网络配置；不要复制其他机器的 127.0.0.1 代理）
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY=

# Telegram 定向通知模式（Phase C）：broadcast=现状全员广播（默认，保持不变）；
# shadow=只记录路由判定不发送；directed=按用户策略实例定向推送。
# directed 必须搭配 MULTI_USER_EXECUTION_MODE=enforced，否则启动校验拒绝。
TELEGRAM_NOTIFICATION_MODE=broadcast

# 绑定开关：开启需 TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_USERNAME/TELEGRAM_WEBHOOK_SECRET 齐备，
# 且 TELEGRAM_WEBHOOK_PUBLIC_URL 为公网可信 https://（159 HTTP、113 自签名证书均不满足，
# 在具备可信公网 HTTPS 端点前保持 false，关闭绑定不影响其余功能）。
TELEGRAM_BINDING_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PUBLIC_URL=

# WxPusher 应用通知渠道（真实值写进 .env.prod 并保密，勿提交仓库）
WXPUSHER_APP_TOKEN=
WXPUSHER_APP_ID=0
WXPUSHER_APP_KEY=
# 回调路径鉴权 key：至少 32 个随机字符
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 绝不能提交真实值（泄漏=任意人可伪造绑定回调）
WXPUSHER_WEBHOOK_PATH_KEY=
WXPUSHER_BINDING_ENABLED=false
WXPUSHER_DELIVERY_ENABLED=false
WXPUSHER_CHALLENGE_TTL_SECONDS=600
WXPUSHER_TIMEOUT_SECONDS=8

# 运维告警：企业微信群机器人 webhook。Task 12 起只承载运维白名单告警
# （渠道鉴权失败/投递积压/worker 停滞/终态失败率），业务正文不再进入
ALERT_WEBHOOK_URL=
