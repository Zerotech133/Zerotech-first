{
  "_meta": {
    "schema_version": "1.0.0",
    "wo": "WO-STRAT-CARDS-20261031",
    "phase": "Phase 0-A",
    "purpose": "把 quant_backtest/strategies/manifests/ 的 10 个运行 manifest 归一为可组合 Strategy Card；本文件是只读 overlay，不改 10 个 manifest 既有字段，不改 strategy_registry.json 运行语义。",
    "source_manifests": "quant_backtest/strategies/manifests/*.manifest.json",
    "source_registry": "quant_backtest/strategy_layer/strategy_registry.json",
    "field_derivation": {
      "strategy_id": "manifest.strategy_id（全局唯一，装配/注册同名）",
      "version": "manifest.version（强一致；改本体逻辑必须升 version）",
      "owner": "A0 归一：按源码归属工位命名（classic/strategy-layer/chanlun/nine-dim/qpzm/rps/risk），非运行语义",
      "universe": "由 manifest allowed_data + 源码/计划任务实际市场范围归一（名称为市场令牌列表，非枚举约束）",
      "frequency": "由 manifest allowed_data 的 bar 周期与执行入口归一",
      "horizon_days": "A0 归一初值（源码持有期/评估窗口径）；Phase 0-B strategy_health 用后验校准，本字段不代表运行参数",
      "signal_schema": "由 manifest _provenance.source_symbol + 源码产出口径归一（kind/actions/字段）",
      "regime_tags": "由源码语义与 BATCH1/BATCH2 DOSIER 的适用场景归一（标签非枚举约束）",
      "known_failure_modes": "由 BATCH1/BATCH2 DOSIER 的风险点 + 源码降级语义归一",
      "data_deps": "manifest.allowed_data 原样镜像（validate_card 强一致校验）",
      "capacity": "manifest.resource_budget 原样镜像（validate_card 强一致校验）",
      "params_schema": "由 manifest _provenance.source_symbol + 源码常量/PARAM_DEFAULTS/config.json 归一",
      "modes": "manifest.allowed_modes 原样镜像（validate_card 强一致校验）",
      "health": "Phase 0-A 固定为空 {}；健康度由 Phase 0-B strategy_health 只读产出为独立 HealthCard，不回写本文件"
    },
    "activation_policy": "只读 overlay：不修改 manifest、不写 strategy_registry.json、不注册 adapter、不新增计划任务；默认不启用任何新增策略（当前运行语义零变更）。",
    "shadow_candidate_rule": "shadow_candidates = 10 张卡中未处于 registry enabled 的卡，扣除非选股 overlay（signal_schema.kind=position_scale 的 vol_target：只输出仓位缩放系数、无独立选股信号流，不进入信号影子候选）。当前 registry enabled=[kg_boost, chan_monitor]，其中仅 chan_monitor 有 manifest 卡；kg_boost 为 adapter-only（无 manifest，见 registry_only_enabled_ids）。因此 10 卡 - 1 张在册启用卡（chan_monitor） - 1 张非选股 overlay（vol_target）= 8 张 shadow_candidates 选股卡。",
    "normalized_values_note": "universe/frequency/horizon_days/signal_schema/regime_tags/known_failure_modes/params_schema 属 A0 归一初值，用于组合与健康度接线；正式值待 Phase 0-B 校准，不构成对运行行为的修改。",
    "enabled_baseline": {
      "registry_enabled_ids": ["kg_boost", "chan_monitor"],
      "enabled_count": 2,
      "enabled_card_ids": ["chan_monitor"],
      "shadow_candidates_count": 8,
      "note": "数字口径见 shadow_candidate_rule；kg_boost 当前无 manifest 卡，不改 10 manifest 范围。"
    }
  },
