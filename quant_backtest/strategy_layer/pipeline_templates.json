{
  "_meta": {
    "schema": "pipeline_templates/v1",
    "ir_schema": "composition_ir/v1",
    "wo": "WO-PIPELINE-TEMPLATES-20261031",
    "phase": "Phase 2-E",
    "purpose": "可直接复用的组合流水线模板库：每个模板是一条合法的 Composition IR（composition_ir/v1），默认只读、execution dry-run、publish 不生效。",
    "source_ir_module": "quant_backtest/strategy_layer/composition_ir.py",
    "source_cards": "quant_backtest/strategy_layer/strategy_cards.json（10 张 Strategy Card，只读引用）",
    "safety": {
      "readonly": true,
      "executes": false,
      "places_orders": false,
      "writes_ledger": false,
      "publishes": false,
      "writes_registry": false,
      "note": "模板只在内存中产出 IR / 编译计划；load_template 的参数覆写不落盘、不写 strategy_registry.json、不注册 adapter、不新增计划任务。"
    },
    "parameterization": {
      "tenant": "多租户隔离键（Phase 0-C 口径）；覆写仅作用于返回的 IR 副本。",
      "weights": "allocator 节点的策略权重表（键必须是本模板 strategy 节点用到的 strategy_id）；覆写仅内存。",
      "max_single": "单票上限（percent，写入 risk_policy.max_position_pct 及 allocator.params.max_single_pct）；覆写仅内存。",
      "rule": "默认值见每个模板的 parameters 块；load_template(name, tenant=..., weights=..., max_single=...) 只改返回副本，原始模板 JSON 不被修改。"
    },
    "templates": [
      "trend_pullback",
      "trend_reversal",
      "nine_dim_chan"
    ]
  },
  "templates": [
    {
      "template_id": "trend_pullback",
      "title": "趋势回踩",
      "description": "趋势跟随（trend_follow）为唯一信号源：universe → strategy → filter（量能/回踩过滤）→ allocator（加权）→ risk → execution（dry_run）。默认单票上限 8%。",
      "parameters": {
        "tenant": {
          "type": "str",
          "default": "official",
          "description": "多租户隔离键（覆写仅内存，不写 registry）"
        },
        "weights": {
          "type": "dict",
          "default": {
            "trend_follow": 1.0
          },
          "description": "allocator 策略权重（键必须属于本模板 strategy 节点）"
        },
        "max_single": {
          "type": "float",
          "default": 8.0,
          "description": "单票上限 %（(0,100]，写入 risk_policy.max_position_pct）"
        }
      },
      "ir": {
        "schema": "composition_ir/v1",
        "pipeline_id": "pc-template-trend-pullback",
        "version": "1.0.0",
        "owner": "quant-classic",
        "tenant": "official",
        "mode": "SHADOW",
        "description": "模板：趋势回踩（trend_follow 单策略 + filter/allocator/risk/execution，只读计划）",
        "nodes": [
          {
            "id": "u_cn",
            "type": "universe",
            "label": "CN 股票池",
            "params": {
              "markets": [
                "CN"
              ]
            }
          },
          {
            "id": "s_trend",
            "type": "strategy",
            "label": "趋势跟随",
            "strategy_id": "trend_follow",
            "params": {
              "n": 20,
              "slope_lookback": 5
            }
          },
          {
            "id": "f_pullback",
            "type": "filter",
            "label": "回踩/量能过滤",
            "params": {
              "min_amount": 50000000,
              "pullback_pct": 3.0,
              "require_above_ma": true
            }
          },
          {
            "id": "a_weight",
            "type": "allocator",
            "label": "加权分配",
            "params": {
              "scheme": "weighted",
              "weights": {
                "trend_follow": 1.0
              },
              "max_single_pct": 8.0
            }
          },
          {
            "id": "k_risk",
            "type": "risk",
            "label": "风控闸",
            "params": {}
          },
          {
            "id": "x_paper",
            "type": "execution",
            "label": "纸面执行（dry-run）",
            "params": {
              "book": "official",
              "dry_run": true
            }
          }
        ],
        "edges": [
          {
            "from": "u_cn",
            "to": "s_trend",
            "port": "universe"
          },
          {
            "from": "s_trend",
            "to": "f_pullback",
            "port": "signals"
          },
          {
            "from": "f_pullback",
            "to": "a_weight",
            "port": "signals"
          },
          {
            "from": "a_weight",
            "to": "k_risk",
            "port": "allocations"
          },
          {
            "from": "k_risk",
            "to": "x_paper",
            "port": "allocations"
          }
        ],
        "risk_policy": {
          "policy_id": "rp-trend-pullback",
          "max_position_pct": 8.0,
          "max_positions": 20,
          "max_gross_exposure_pct": 80.0,
          "stop_loss_pct": 6.0,
          "kill_switch": true,
          "notes": "趋势回踩模板默认风控（只读计划，不生效）"
        },
        "publish": {
          "enabled": false,
          "channel": "paper",
          "visibility": "private",
          "requires_approval": true,
          "notes": "模板默认不发布；发布需人工审批后另行评估"
        }
      }
    },
